{
  "name": "ayd",
  "version": "0.0.0",
  "private": true,
  "description": "Automate your demo(n)s — an AI-assisted, Playwright-driven product demo runner.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "typecheck": "tsgo -b",
    "typecheck:tsc": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc -b --clean && rm -rf coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "latest",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}

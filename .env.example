# Copy to .env (gitignored) and fill in locally. NEVER commit real values.
# The AI planner authenticates through the user's Claude Code login (OAuth), so
# no Anthropic API key is required here by default. This file documents the
# optional/local knobs only.

# Base URL of the app you are demoing (e.g. a local or staging host).
AYD_TARGET_BASE_URL=

# Pacing for the headed run, in milliseconds.
AYD_PACE_MS=3000
AYD_SLOWMO_MS=180

# Demo personas and credentials are SENSITIVE and belong in a gitignored local
# profile, not here. See config/local/ (gitignored) and docs/architecture.md.

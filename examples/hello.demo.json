    {
      "action": "navigate",
      "personaId": "user",
      "path": "https://example.com",
      "caption": "opening a page"
    },
    {
      "action": "highlight",
      "personaId": "user",
      "target": { "kind": "role", "role": "heading" },
      "label": "the headline"
    },
    {
      "action": "expect",
      "personaId": "user",
      "target": { "kind": "text", "text": "Example Domain" },
      "toBe": "visible",
      "label": "page loaded"
    }
  ]
}
